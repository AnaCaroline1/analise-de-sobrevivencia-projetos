jan <- read_excel("INSS_TM/CONCEDIDOS_DADOS_ABERTOS_JANEIRO+2025.xlsx",
skip = 1,
.name_repair = "unique"
) |>
## ---------------------------------------------------------------
## Pipeline: leitura + padronização + filtro + consolidação
## Estratégia: ler -> limpar nomes -> filtrar -> escrever (1 arquivo por vez)
## Nunca empilha tudo antes de filtrar -> economiza RAM e tempo
## ---------------------------------------------------------------
# --------------------------------------------------------------
# 1) Dicionário de renomeação manual (para os casos que o
#    clean_names() sozinho não resolve, tipo sinônimos/duplicatas)
# --------------------------------------------------------------
dicionario_nomes <- c(
"APS...1"          = "cd_aps",
"APS...2"    = "nm_aps",
"Competência concessão"      = "comp_conssesao",
"Espécie...4"   = "cd_especie",
"Espécie...5"    = "nm_especie",
"CID...6" = "cd_cid",
"CID...7" = "des_cid",
"Dt Nascimento" = "dt_nasc",
"Clientela" = "clientela",
"Mun Resid" = "mun_res",
"Vínculo dependentes" = "vinc_dependent",
"Forma Filiação" = "forma_filiacao",
"UF" = "uf",
"Qt SM RMI" = "qt_sm_rmi",
"Ramo Atividade" = "r_ativ",
"Dt DCB" = "dt_dcb",
"Dt DDB" = "dt_ddb",
"Dt DIB" = "dt_dib",
"País de Acordo Internacional" = "p_acord_int",
"Classificador PA" = "class_pa"
# adicione aqui todos os mapeamentos que você já levantou
)
