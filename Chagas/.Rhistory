.x == "00/00/0000" | is.na(.x) ~ NA_Date_,
str_detect(as.character(.x), "^[0-9]+$") ~ excel_numeric_to_date(as.numeric(.x)),
TRUE ~ as.Date(parse_date_time(.x, orders = c("dmy", "ymd")))
)
)
)
