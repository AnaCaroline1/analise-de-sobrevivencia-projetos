nomes_21 <- c("Grau Instrução","CNAE 2.0...25","CNAE 2.0...24","Classificador PA",
"Dt DIB","Dt DDB","Dt DCB","Ramo Atividade","Qt SM RMI","UF",
"Forma Filiação","Vínculo dependentes","Mun Resid","Clientela","Sexo.",
"Dt Nascimento","Despacho...9","CID...7","CID...6",
"Competência concessão","APS...2")
nomes_24 <- c(nomes_21, "País de Acordo Internacional","APS...1","Qt Anos Contribuição")
inss_fit1 <- function(caminho) {
df <- read_parquet(caminho)
n  <- ncol(df)
nomes_usar <- if (n == length(nomes_21)) {
nomes_21
} else if (n == length(nomes_24)) {
nomes_24
} else {
warning(sprintf("Arquivo com número inesperado de colunas (%d): %s", n, caminho))
return(NULL)  # ou: return(df) sem renomear, se preferir inspecionar depois
}
df |>
setNames(nomes_usar) |>
select(any_of(nomes_24))  # padroniza colunas usando o conjunto "cheio"
}
inss_fitf <- map_dfr(arq, inss_fit1, .id = "arquivo")
