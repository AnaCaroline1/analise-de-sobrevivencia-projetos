arq <- list.files(path = "fit_inss/", pattern = "\\.parquet$", full.names = T)
limpar_nomes <- function(df) {
df %>%
rename_with(~ str_remove(.x, "\\.\\.\\.\\d+$"))
}
# lê CADA arquivo, limpa os nomes, e guarda numa lista
lista_bases <- map(arq, ~ read_parquet(.x)
|> limpar_nomes())
limpar_nomes <- function(df) {
novos_nomes <- names(df) %>%
str_remove("\\.\\.\\.\\d+$")          # tira o sufixo ...N
names(df) <- make.unique(novos_nomes, sep = "_")  # deixa único: APS, APS_1, APS_2...
df
}
lista_bases <- map(arq, ~ read_parquet(.x) %>% limpar_nomes())
# confere se agora ficou tudo único
map(lista_bases, ~ names(.x)[duplicated(names(.x))])
inss_pa <- bind_rows(lista_bases)
limpar_nomes <- function(df) {
novos_nomes <- names(df) %>%
str_remove("\\.\\.\\.\\d+$")
names(df) <- make.unique(novos_nomes, sep = "_")
df
}
lista_bases <- map(
arq,
~ read_parquet(.x) %>%
limpar_nomes() %>%
mutate(across(everything(), as.character))   # força tudo pra texto
)
inss_pa <- bind_rows(lista_bases)
view(inss_pa)
write_parquet(inss_pa, "inss_pa.parquet")
