house_pz <- read.csv("housepricedata.csv")
head(house_pz)
house_pz_sdic <- house_pz |>
select(-FullBath,-HalfBath,-Fireplaces,-AboveMedianPrice)
house_p <- prcomp(house_pz_sdic, center = FALSE, scale. = TRUE)
summary(house_p)
fviz_eig(house_p, addlabels = TRUE)
house_pz_sdic_pca <- house_p$x[,"PC1"]
corrplot(cor(house_pz_sdic),
method = "color",
type = "full",
tl.col = "black",
tl.cex = 0.7,
col = colorRampPalette(c("yellow", "lightblue", "darkblue"))(200))
house_pz_s <- scale(house_pz_sdic)
ajuste_k <- 1:8
sse_valores <- numeric(8)
set.seed(123)
for (k in ajuste_k) {
kmeans_mod <- kmeans(house_pz_s, centers = k, nstart = 25)
sse_valores[k] <- kmeans_mod$tot.withinss
}
# Gráfico do cotovelo
df_house_cot <- data.frame(Clusters = ajuste_k, SSE = sse_valores)
ggplot(df_house_cot, aes(x = Clusters, y = SSE)) +
geom_line(color = "darkblue", size = 1) +
geom_point(color = "red", size = 3)+
scale_x_continuous(breaks = 1:8)+
labs(title = "Gráfico de Cotovelo para os dados House Price",
x = "Nº de Clusters (K)",
y = "Soma dos Erros Quadrados (SSE)")+
theme_minimal()
k_ideal2 <- 2
kmeas_final2 <- kmeans(house_pz_s, centers = k_ideal2, nstart = 25)
house_pz$Clusters_kmeans <- as.factor(kmeas_final2$cluster)
tabela_comparativa2 <- table(Real = house_pz$AboveMedianPrice, Agrupado = house_pz$Clusters_kmeans)
tabela_comparativa2
