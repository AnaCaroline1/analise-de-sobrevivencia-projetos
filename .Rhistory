log_vero_expo_atf <- function(par, t,delta, X){
beta0 <- par[1]
beta <- par[-1]
betas <- beta0 + X %*% beta
ll <- sum(
delta * (-betas) - t / exp(betas)
)
return(-ll)
}
p <- ncol(X)
log_vero_weibull_atf <- function(par, t, delta, X){
beta0 <- par[1]
beta <- par[2:(ncol(X)+1)]
log_gamma <- par[length(par)]
gamma <- exp(log_gamma)
eta <- beta0 + X %*% beta
ll <- sum(
delta * (
log(gamma) +
(gamma - 1)*log(t) -
gamma*eta
) -
(t/exp(eta))^gamma
)
return(-ll)
}
fit_w <- optim(
par = c(rep(0, ncol(X)+1), 0),
fn = log_vero_weibull_atf,
tempo = t,
status = delta,
X = X,
hessian = TRUE
)
log_vero_weibull_atf <- function(par, t, delta, X){
beta0 <- par[1]
beta <- par[2:(ncol(X)+1)]
log_gamma <- par[length(par)]
gamma <- exp(log_gamma)
eta <- beta0 + X %*% beta
ll <- sum(
delta * (
log(gamma) +
(gamma - 1)*log(t) -
gamma*eta
) -
(t/exp(eta))^gamma
)
return(-ll)
}
fit_w <- optim(
par = c(rep(0, ncol(X)+1), 0),
fn = log_vero_weibull_atf,
t = tempo,
delta = status,
X = X,
hessian = TRUE
)
