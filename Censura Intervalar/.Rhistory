library(tseries)
library(forecast)
library(gt)
library(FinTS)
library(rugarch)
library(zoo)
# Código da série do IBCR-AM com ajuste sazonal no BCB
# codigo_ibcr_am <- 25412
#
# ibcr_am <- gbcbd_get_series(
#   id = codigo_ibcr_am,
#   first.date = "2000-01-01", # O IBCR costuma iniciar em 2003/2003
#   last.date = Sys.Date()
# )
# icbr <- as.data.frame(ibcr_am)
#readr::write_csv(icbr, "ibcr_am.csv") #-> Aqui salvo como csv para não puxar todo tempo.
ibcr_am <- read.csv("ibcr_am.csv")
ibcr <- ibcr_am |>
select(ref.date,value) |>
mutate(ref.date = as.Date(ref.date))
# CRIAÇÃO DOS OBJETOS DE SÉRIE TEMPORAL (ts)
ts_ibcr <- ts(
ibcr$value,
start = c(2003, 1),
frequency = 12
)
# Identificação do ano
# ----
ano_ibcr <- floor(time(ts_ibcr))
# Criação dos períodos de 5 anos
periodo_ibcr <- cut(
ano_ibcr,
breaks = seq(2003, 2030, by = 5),
right = FALSE
)
# Criação do data frame
dados_periodo_ibcr <- data.frame(
periodo = periodo_ibcr,
ibcr = as.numeric(ts_ibcr)
)
# Agrupamento e cálculo das estatísticas em uma única etapa
tabela_dados <- aggregate(
ibcr ~ periodo,
data = dados_periodo_ibcr,
FUN = function(x) c(
Media = mean(x, na.rm = TRUE),
Variancia = var(x, na.rm = TRUE),
DesvioPadrao = sd(x, na.rm = TRUE)
)
)
# Converte a matriz interna criada pelo aggregate em colunas separadas
tabela_dados <- do.call(data.frame, tabela_dados)
colnames(tabela_dados) <- c("Periodo", "Media", "Variancia", "DesvioPadrao")
# NOTA (revisão): esta é a única tabela do relatório que usa tab_header()
# com title + subtitle (cabeçalho de DUAS linhas). Esse é justamente o
# padrão associado a bugs conhecidos de "gt em PDF via Quarto" que geram
# o erro "Paragraph ended before \@argarraycr was complete.". Se, mesmo
# depois de carregar longtable/booktabs/array/colortbl (ver YAML), o erro
# persistir, comente a linha do subtitle abaixo para testar se é ela a
# causa antes de investigar mais.
tab_desc <- tabela_dados |>
gt() |>
tab_header(
title = "Estatísticas Descritivas do IBCR-AM",
subtitle = "Média, Variância e Desvio-Padrão agrupados por quinquênios"
) |>
cols_label(
Periodo = "Período",
Media = "Média",
Variancia = "Variância",
DesvioPadrao = "Desvio-Padrão"
) |>
fmt_number(
columns = c(Media, Variancia, DesvioPadrao),
decimals = 4,
dec_mark = ",",
sep_mark = "."
) |>
cols_align(
align = "center",
columns = everything()
) |>
tab_source_note(source_note = md("Fonte: Elaboração própria")) |>
opt_stylize(style = 1, color = "gray")
# TRATAMENTO ECONOMÉTRICO
# Aplicação de ln:
# Como a série cresce ao longo do tempo, o logaritmo estabiliza a variância permitindo interpretar coeficientes.
log_ibcr <- log(ts_ibcr)
# Calculo das diferenças primeiras:
# Caso a série apresente raiz unitária I(1).
diff_log_ibcr <- diff(log_ibcr)
# Filtrar e Plotar o IBCR do Amazonas
# IBCR - Índice Brasileiro de Atividade Econômica do Banco Central
# ----
graf_am <- ibcr |>
ggplot(aes(x = ref.date, y = value)) +
geom_line(color = "darkred", size = 1) +
geom_hline(
yintercept = mean(ibcr$value, na.rm = TRUE),
color = "blue",
linetype = "dashed",
size = 1
) +
theme_minimal() +
labs(
title = "Validação: IBCR - Amazonas (Série Histórica)",
subtitle = "Fonte: Banco Central do Brasil (BCB-Depec 25412)",
x = "Ano",
y = "Índice (2003 = 100)"
) +
scale_x_date(
date_breaks = "5 years",
date_labels = "%Y"
)
periodos <- data.frame(
inicio = as.Date(c("2003-01-01", "2015-01-01", "2020-01-01")),
fim    = as.Date(c("2014-12-31", "2019-12-31", "2026-12-31")),
meio   = as.Date(c("2009-07-01", "2017-07-01", "2023-07-01")),
rotulo = c(
"2003-2014\nBoom de Commodities &\nCrescimento do PIM",
"2015-2019\nRecessão Nacional &\nLenta Recuperação",
"2020-2026\nChoque Pandêmico &\nNovos Incentivos ZFM"
),
cor_fundo    = c("#2b6cb0", "#c53030", "#6b46c1"),
cor_marcador = c("#1a365d", "#742a2a", "#44337a")
)
#----
max_y <- max(ibcr$value, na.rm = TRUE)
min_y <- min(ibcr$value, na.rm = TRUE)
altura_linha <- max_y * 1.12
altura_texto <- max_y * 1.18
graf_serie_s <- ggplot() +
geom_rect(
data = periodos,
aes(xmin = inicio, xmax = fim, ymin = -Inf, ymax = Inf, fill = rotulo),
alpha = 0.08
) +
scale_fill_manual(values = periodos$cor_fundo, guide = "none") +
geom_line(
data = ibcr,
aes(x = ref.date, y = value),
color = "#2b5c8f", linewidth = 1
) +
geom_segment(
aes(x = min(periodos$inicio), xend = max(periodos$fim),
y = altura_linha, yend = altura_linha),
color = "#718096", linewidth = 0.8
) +
geom_point(
data = periodos,
aes(x = inicio, y = altura_linha),
color = periodos$cor_marcador, size = 3, shape = 21,
fill = "white", stroke = 1.8
) +
geom_point(
aes(x = max(periodos$fim), y = altura_linha),
color = periodos$cor_marcador[3], size = 3, shape = 21,
fill = "white", stroke = 1.8
) +
geom_text(
data = periodos,
aes(x = meio, y = altura_texto, label = rotulo, color = rotulo),
fontface = "bold", size = 3.2, vjust = 0, lineheight = 0.9,
show.legend = FALSE
) +
scale_color_manual(values = periodos$cor_marcador) +
scale_x_date(date_breaks = "3 years", date_labels = "%Y",
expand = expansion(mult = c(0.02, 0.02))) +
scale_y_continuous(limits = c(min_y * 0.95, max_y * 1.35)) +
labs(
title = "Evolução Temporal e Contextos Econômicos no Amazonas",
subtitle = "Divisão por marcos de desempenho do PIM e choques macroeconômicos (2003-2026)",
x = NULL, y = "Variação Mensal (%)"
) +
theme_minimal(base_family = "sans") +
theme(
panel.background = element_rect(fill = "#fdfdfd", color = NA),
plot.background  = element_rect(fill = "#fdfdfd", color = NA),
panel.grid.major.x = element_line(color = "#e2e8f0", linetype = "dashed"),
panel.grid.major.y = element_line(color = "#e2e8f0"),
panel.grid.minor = element_blank(),
axis.text.x = element_text(color = "#4a5568", size = 9),
axis.text.y = element_text(color = "#4a5568", size = 9),
plot.title = element_text(face = "bold", size = 14, color = "#1a202c"),
plot.subtitle = element_text(size = 10, color = "#718096", margin = margin(b = 15))
)
#| warning: false
# Estacionariedade & Raiz Unitária
# (Testes ADF e KPSS em nível e na 1ª diferença)
# --- IBCR-AM (AM) ---
adf_ibcr <- adf.test(as.numeric(ts_ibcr))
# Em Nível (Log): Espera-se p-valor > 0.05 (Não rejeita H0: Não-estacionária)
adf_ibcr_nivel <- adf.test(as.numeric(log_ibcr))
# Em Primeira Diferença: Espera-se p-valor <= 0.05 (Rejeita H0: Estacionária)
adf_ibcr_diff <- adf.test(as.numeric(diff_log_ibcr))
kpss_ibcr <- kpss.test(as.numeric(ts_ibcr))
kpss_ibcr_n <- kpss.test(as.numeric(log_ibcr))
kpss_ibcr_diff <- kpss.test(as.numeric(diff_log_ibcr))
# ----
testes_ibcr <- list(
"Teste ADF - IBCR-AM" = adf_ibcr,
"Teste ADF - log(IBCR-AM)" = adf_ibcr_nivel,
"Teste ADF - diff(IBCR-AM)" = adf_ibcr_diff,
"Teste KPSS - IBCR-AM" = kpss_ibcr,
"Teste KPSS - log(IBCR-AM)" = kpss_ibcr_n,
"Teste KPSS - diff(IBCR-AM)" = kpss_ibcr_diff
)
tab_test_icbcbr <- map2_dfr(
testes_ibcr,
names(testes_ibcr),
~ tibble(Testes = .y, p_value = round(.x$p.value, 4))) |>
gt() |>
tab_header(title = "Testes ADF e KPSS para IBCR - AM") |>
cols_label(p_value = "Valor-p") |>
tab_source_note(source_note = md("Fonte: Elaboração própria")) |>
opt_stylize(style = 1, color = "gray")
# termos de médias móveis
acf(
diff_log_ibcr,
lag.max = 36,
main = "ACF - Série diferenciada"
)
# componentes autorregressivos
pacf(
diff_log_ibcr,
lag.max = 36,
main = "PACF – Série diferenciada"
)
#| include: false
modelo_ibcr <- auto.arima(
log_ibcr,
seasonal = FALSE,
allowdrift = FALSE,
approximation = FALSE,
trace = TRUE
)
residuos_arima_auto <- residuals(modelo_ibcr)
# Testes de diagnóstico
lbox_arima <- Box.test(residuos_arima_auto, lag = 12, type = "Ljung-Box")
lbox_arima_2 <- Box.test(residuos_arima_auto^2, lag = 12, type = "Ljung-Box")
arch_arima <- ArchTest(residuos_arima_auto, lags = 12)
top_mod_arima <- list(
"ARIMA(1,1,3)" = -1168.918,
"ARIMA(0,1,3)" = -1170.983,
"ARIMA(0,1,4)" = -1168.916
)
tab_top_mod <- map2_dfr(
top_mod_arima,
names(top_mod_arima),
~ tibble(Modelos = .y, AIC = .x)) |>
gt() |>
tab_header(title = "Modelos Arima pelo critério AIC") |>
tab_source_note(source_note = md("Fonte: Elaboração própria")) |>
opt_stylize(style = 1, color = "gray")
testes_diag <- list(
"Teste Ljung-Box - Arima(0,1,3)" = lbox_arima,
"Teste Ljung-Box^2 - Arima(0,1,3)" = lbox_arima_2,
"Teste Arch - Resíduos Arima(0,1,3)" = arch_arima
)
tab_test_diag <- map2_dfr(
testes_diag,
names(testes_diag),
~ tibble(Testes = .y, p_value = round(.x$p.value, 4))) |>
gt() |>
tab_header(title = "Testes Diagnósticos (Arima): Ljung-Box, Ljung-Box² e Arch") |>
cols_label(p_value = "Valor-p") |>
tab_source_note(source_note = md("Fonte: Elaboração própria")) |>
opt_stylize(style = 1, color = "gray")
especificacao_garch <- ugarchspec(
variance.model = list(
model = "eGARCH",
garchOrder = c(1, 1)
),
mean.model = list(
armaOrder = c(1, 3),
include.mean = T
),
distribution.model = "std"
)
garch_11 <- ugarchfit(
spec = especificacao_garch,
data = log_ibcr
)
# Previsão para os próximos 12 meses
prev_12 <- ugarchforecast(
garch_11,
n.ahead = 12
)
pred_media <- as.numeric(fitted(prev_12)) # previsão pontual (escala log)
pred_sigma <- as.numeric(sigma(prev_12))  # desvio-padrão condicional (escala log)
alpha_ic <- 0.05
z_critico <- qnorm(1 - alpha_ic / 2) # ~1,96
lim_inf_log <- pred_media - z_critico * pred_sigma
lim_sup_log <- pred_media + z_critico * pred_sigma
# Retorno à escala original do IBCR-AM
pred_media_nivel <- exp(pred_media)
lim_inf_nivel    <- exp(lim_inf_log)
lim_sup_nivel    <- exp(lim_sup_log)
datas_obs <- as.Date(time(ts_ibcr))
ultima_data <- tail(datas_obs, 1)
datas_prev <- seq(
from = as.Date(as.yearmon(ultima_data) + 1/12),
by = "month",
length.out = 12
)
df_obs <- data.frame(
data = datas_obs,
valor = as.numeric(ts_ibcr),
tipo = "Observado"
)
df_prev <- data.frame(
data = datas_prev,
valor = pred_media_nivel,
lim_inf = lim_inf_nivel,
lim_sup = lim_sup_nivel,
tipo = "Previsto"
)
graf_prev <- ggplot() +
geom_line(
data = df_obs,
aes(x = data, y = valor),
color = "black"
) +
geom_ribbon(
data = df_prev,
aes(x = data, ymin = lim_inf, ymax = lim_sup),
fill = "steelblue",
alpha = 0.2
) +
geom_line(
data = df_prev,
aes(x = data, y = valor),
color = "steelblue",
linewidth = 1
) +
geom_line(
data = df_prev,
aes(x = data, y = lim_inf),
color = "steelblue",
linetype = "dashed"
) +
geom_line(
data = df_prev,
aes(x = data, y = lim_sup),
color = "steelblue",
linetype = "dashed"
) +
# Linha vertical separando observado e previsto
# (usar a Date diretamente, sem as.numeric(), evita o warning do
# scale_x_date sobre valor numérico passado a um eixo de datas)
geom_vline(
xintercept = ultima_data,
linetype = "dashed",
color = "gray40"
) +
labs(
x = "Ano",
y = "IBCR-AM (%)",
title = "IBCR-AM – Previsão dos próximos 12 meses"
) +
theme_minimal()
#| include: false
modelo_ibcr2 <- auto.arima(
log_ibcr,
seasonal = TRUE,
allowdrift = FALSE,
approximation = FALSE,
trace = TRUE
)
residuos_sarima_auto <- residuals(modelo_ibcr2)
lbox_sarima <- Box.test(residuos_sarima_auto, lag = 12, type = "Ljung-Box")
lbox_sarima_2 <- Box.test(residuos_sarima_auto^2, lag = 12, type = "Ljung-Box")
arch_sarima <- ArchTest(residuos_sarima_auto, lags = 12)
top_mod_sarima <- list(
"ARIMA(0,1,3)" = -1170.983,
"ARIMA(0,1,3)(1,0,0)[12]" = -1171.746,
"ARIMA(0,1,3)(0,0,1)[12]" = -1172.106
)
tab_top_mod2 <- map2_dfr(
top_mod_sarima,
names(top_mod_sarima),
~ tibble(Modelos = .y, AIC = .x)) |>
gt() |>
tab_header(title = "Modelos Sarima pelo critério AIC") |>
tab_source_note(source_note = md("Fonte: Elaboração própria")) |>
opt_stylize(style = 1, color = "gray")
testes_diag2 <- list(
"Teste Ljung-Box - SARIMA(0,1,3)(0,0,1)[12]" = lbox_sarima,
"Teste Ljung-Box^2 - SARIMA(0,1,3)(0,0,1)[12]" = lbox_sarima_2,
"Teste Arch - Resíduos SARIMA(0,1,3)(0,0,1)[12]" = arch_sarima
)
tab_test_diag2 <- map2_dfr(
testes_diag2,
names(testes_diag2),
~ tibble(Testes = .y, p_value = round(.x$p.value, 4))) |>
gt() |>
tab_header(title = "Testes Diagnósticos (Sarima): Ljung-Box, Ljung-Box² e Arch") |>
cols_label(p_value = "Valor-p") |>
tab_source_note(source_note = md("Fonte: Elaboração própria")) |>
opt_stylize(style = 1, color = "gray")
especificacao_garch_sarima <- ugarchspec(
variance.model = list(
model = "eGARCH",
garchOrder = c(1, 1)
),
mean.model = list(
armaOrder = c(0, 0),
include.mean = FALSE
),
distribution.model = "std"
)
garch_sarima_11 <- ugarchfit(
spec = especificacao_garch_sarima,
data = residuos_sarima_auto
)
graf_serie_s
tab_desc
graf_am
# Decomposição aditiva
plot(decompose(ts_ibcr, type = "additive"))
# Decomposição multiplicativa
plot(decompose(ts_ibcr, type = "multiplicative"))
tab_test_icbcbr
# termos de médias móveis
acf(
diff_log_ibcr,
lag.max = 36,
main = "ACF - Série diferenciada"
)
# componentes autorregressivos
pacf(
diff_log_ibcr,
lag.max = 36,
main = "PACF – Série diferenciada"
)
tab_top_mod
# Gráfico dos resíduos
plot(
residuos_arima_auto,
main = "Resíduos do ARIMA (auto.arima)",
ylab = "Resíduo",
xlab = "Tempo"
)
abline(h = 0, lty = 2)
# ACF e PACF dos resíduos
acf(
residuos_arima_auto,
lag.max = 36,
main = "ACF dos resíduos - ARIMA auto"
)
pacf(
residuos_arima_auto,
lag.max = 36,
main = "PACF dos resíduos - ARIMA auto"
)
# Resíduos ao quadrado (indício de clusters de volatilidade)
plot(
residuos_arima_auto^2,
type = "l",
main = "Resíduos^2 do ARIMA (indício de clusters de volatilidade)"
)
tab_test_diag
graf_prev
tab_top_mod2
plot(
residuos_sarima_auto,
main = "Resíduos do SARIMA (auto.arima)",
ylab = "Resíduo",
xlab = "Tempo"
)
abline(h = 0, lty = 2)
acf(
residuos_sarima_auto,
lag.max = 36,
main = "ACF dos resíduos - SARIMA auto"
)
pacf(
residuos_sarima_auto,
lag.max = 36,
main = "PACF dos resíduos - SARIMA auto"
)
# Resíduos ao quadrado (indício de clusters de volatilidade)
plot(
residuos_sarima_auto^2,
type = "l",
main = "Resíduos^2 do SARIMA (indício de clusters de volatilidade)"
)
tab_test_diag2
# Reaproveita o modelo já ajustado no chunk "modelo-arima-auto" (rodado
# mais acima, na seção de Resultados). Antes, este chunk chamava
# auto.arima() de novo aqui, o que refazia toda a busca de ordem
# (trace = TRUE) uma segunda vez sem necessidade — daí o modelo parecer
# "recarregar" mesmo numa seção que deveria só exibir o resumo já pronto.
summary(modelo_ibcr)
garch_11
# Idem ao chunk acima: reaproveita modelo_ibcr2, já ajustado no chunk
# "modelo-sarima-auto", em vez de rodar auto.arima(seasonal = TRUE)
# de novo (essa era a busca mais pesada, por isso a demora percebida).
summary(modelo_ibcr2)
garch_sarima_11
